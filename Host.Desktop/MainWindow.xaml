<Window x:Class="AutomationPlatform.Host.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Assistente de Impressão" Width="560" Height="720" MinWidth="420" MinHeight="480"
        Background="#F3F4F6" FontFamily="Segoe UI" FontSize="14">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#1F2937" Padding="16,12">
            <StackPanel>
                <TextBlock Text="Assistente de Impressão" Foreground="White" FontSize="18" FontWeight="SemiBold" />
                <TextBlock Text="Somente leitura: eu só olho, não altero nada no seu computador."
                           Foreground="#D1D5DB" FontSize="12" Margin="0,2,0,0" />
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" x:Name="Scroll" VerticalScrollBarVisibility="Auto" Padding="16,12">
            <StackPanel x:Name="Chat" />
        </ScrollViewer>

        <Border Grid.Row="2" Background="White" Padding="16,12" BorderBrush="#E5E7EB" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="FullButton" AutomationProperties.AutomationId="btn-full"
                        Content="Diagnóstico completo" Padding="14,8" Margin="0,0,10,0" Click="OnFullClick" />
                <Button x:Name="NotPrintingButton" AutomationProperties.AutomationId="btn-not-printing"
                        Content="Impressora não está imprimindo" Padding="14,8" Click="OnNotPrintingClick" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
