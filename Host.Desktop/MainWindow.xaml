<Window x:Class="AutomationPlatform.Host.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Automaxion" Width="560" Height="720" MinWidth="420" MinHeight="520"
        Background="#F3F4F6" FontFamily="Segoe UI" FontSize="14">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#1F2937" Padding="16,12">
            <StackPanel>
                <TextBlock Text="Automaxion" Foreground="White" FontSize="18" FontWeight="SemiBold" />
                <TextBlock Text="Assistente de impressão. Eu mostro o que estou verificando e só altero algo se você confirmar."
                           Foreground="#D1D5DB" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <!-- O log da conversa rola aqui em cima. -->
        <ScrollViewer Grid.Row="1" x:Name="Scroll" VerticalScrollBarVisibility="Auto" Padding="16,12">
            <StackPanel x:Name="ChatPanel" />
        </ScrollViewer>

        <!-- O quadro de impressoras e etapas fica FIXO aqui embaixo e só muda de conteúdo. Aparece quando o fluxo começa. -->
        <Border Grid.Row="2" x:Name="BoardHost" Visibility="Collapsed" Background="White" Padding="16,10"
                BorderBrush="#E5E7EB" BorderThickness="0,1,0,0" MaxHeight="300" />

        <Border Grid.Row="3" Background="White" Padding="16,12" BorderBrush="#E5E7EB" BorderThickness="0,1,0,0">
            <Button x:Name="NotPrintingButton" AutomationProperties.AutomationId="btn-not-printing"
                    Content="Impressora não imprime" Padding="14,8" HorizontalAlignment="Left" Click="OnNotPrintingClick" />
        </Border>
    </Grid>
</Window>
